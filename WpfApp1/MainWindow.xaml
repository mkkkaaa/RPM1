<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть" Click="Open_Click"/>
                <MenuItem Header="Сохранить" Click="Save_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Данные">
                <MenuItem Header="Заполнить" Click="Fill_Click"/>
                <MenuItem Header="Очистить" Click="Clear_Click"/>
            </MenuItem>
            <MenuItem Header="Справка">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Панель управления -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Количество элементов:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtCount" Width="80" Margin="5" Text="10"/>
            <TextBlock Text="Диапазон случайных чисел:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtRange" Width="80" Margin="5" Text="100"/>
            <Button Content="Заполнить" Click="Fill_Click" Margin="5" Padding="10,5"/>
            <Button Content="Рассчитать" Click="Calculate_Click" Margin="5" Padding="10,5"/>
            <Button Content="Очистить" Click="Clear_Click" Margin="5" Padding="10,5"/>
        </StackPanel>

        <!-- Таблица для отображения массива -->
        <DataGrid x:Name="dataGrid" Grid.Row="2" Margin="10" AutoGenerateColumns="True"
                  IsReadOnly="False" CanUserAddRows="False"/>

        <!-- Поле вывода результата -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Произведение чисел &lt; 3:" VerticalAlignment="Center" 
                       FontWeight="Bold" Margin="5"/>
            <TextBlock x:Name="txtResult" VerticalAlignment="Center" 
                       FontWeight="Bold" Foreground="Blue" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>




